PORT=3001
BACKEND_URL=http://localhost:3000
AI_PREDICTOR_URL=http://localhost:8001
SERIAL_PORT_MAIN=/dev/cu.usbserial-10
SERIAL_PORT_SECONDARY=/dev/cu.usbmodem1101
BAUD_RATE=9600
MOCK_MODE=false

# AVFoundation device index for camera capture (snapshot + stream).
# Leave unset to auto-detect: picks the device whose name contains "iPhone"
# (excluding "Desk View"), i.e. the iPhone exposed via Continuity Camera.
# If no iPhone camera is detected, capture fails with a 503 error instead
# of falling back to the Mac's built-in webcam.
# List available devices with: python3 src/capture.py --list (or GET /camera/devices)
# CAMERA_DEVICE=1
