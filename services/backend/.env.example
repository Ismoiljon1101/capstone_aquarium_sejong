# Set to true only for local dev without Arduino hardware
SIMULATE_SENSORS=false

# Database (SQLite default, no config needed)
# DB_PATH=./data/fishlinic.db

# Serial bridge URL (used by ActuatorsService)
# SERIAL_BRIDGE_URL=http://localhost:3001

# AI predictor URL (used by VisionService)
# AI_PREDICTOR_URL=http://localhost:8001

# Veronica provider (OpenRouter preferred when key is present)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local fallback provider
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:e2b
